<div class="container" data-controller="articles">
  <h1>Articles</h1>

  <%= turbo_frame_tag "articles_list" do %>
    <div class="articles-grid">
      <%= render partial: "article", collection: @articles %>
    </div>
  <% end %>

  <%= link_to "New Article", new_article_path, class: "btn btn-primary" %>
</div>
